# Port for Express API server
PORT=3001

# Development Database (PostgreSQL 18 - local database: wayfarer)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/wayfarer"

# Automated Testing Database (PostgreSQL 18 - local database: wayfarer_test)
# Strict safety rule: this must never point to the DATABASE_URL. it's only for testing. 
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/wayfarer_test"

